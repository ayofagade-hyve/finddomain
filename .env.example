# Required: shared code people type into the page so the URL can't be abused
ACCESS_CODE=change-me

# Cognism (step 2). Leave blank to skip.
COGNISM_API_KEY=
COGNISM_BASE_URL=https://app.cognism.com
COGNISM_MIN_SCORE=30

# Upstash Redis via Vercel Marketplace (auto-added when you connect it). Needed for cache + Clay.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Clay (step 3). Leave blank to skip.
CLAY_WEBHOOK_URL=
CLAY_WEBHOOK_TOKEN=
CLAY_WEBHOOK_AUTH_HEADER=x-clay-webhook-auth
CLAY_CALLBACK_SECRET=change-me-too
